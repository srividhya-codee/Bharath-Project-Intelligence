# Bharat Project Intelligence - Environment Variables Example
# Copy to .env for local configuration

# Application Mode
ENVIRONMENT=development
# AI_MODE: 'mock' runs fully local/canned data-driven assistant; 'live' calls Gemini
AI_MODE=mock

# Database Configuration (PostgreSQL; fallbacks to sqlite:///./bharat_intel.db if empty)
DATABASE_URL=postgresql://bpi_user:bpi_password@localhost:5432/bharat_project_intel
POSTGRES_USER=bpi_user
POSTGRES_PASSWORD=bpi_password
POSTGRES_DB=bharat_project_intel

# Vector Database (ChromaDB)
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_PERSIST_DIRECTORY=./data/chroma

# Google Gemini API
# Required only if AI_MODE=live
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Authentication & Security
JWT_SECRET=super_secret_jwt_signing_key_gov_demo_2026_at_least_32_chars
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Frontend Client
VITE_API_BASE_URL=http://localhost:8080/api/v1
